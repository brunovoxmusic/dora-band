# =====================================================
# D.O.R.A. Band Website — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# For Vercel deployment, add these in Project Settings → Environment Variables.

# ---- Database (REQUIRED) ----
# Neon Postgres (recommended for Vercel):
#   1. Go to https://neon.tech → create project
#   2. Copy the connection string (pooled recommended)
#   Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dora?sslmode=require"

# ---- Admin Session Secret (REQUIRED) ----
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="replace-with-a-random-32-char-hex-string"

# ---- Vercel Blob Storage (for file uploads) ----
# Create at: Vercel Dashboard → Storage → Blob → Create
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ---- Site URL (for SEO/OG/sitemap) ----
# Your production domain (without trailing slash)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ---- Admin Credentials (seeded on first deploy) ----
# These are used by the seed script to create the initial admin user.
# Change before deploying! After seeding, update via DB if needed.
ADMIN_EMAIL="admin@dora.band"
ADMIN_PASSWORD="dora2026"
