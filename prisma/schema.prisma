// D.O.R.A. band website — Prisma schema (SQLite for LOCAL DEVELOPMENT)
// For Vercel/Neon deployment use: prisma/schema.postgres.prisma
// Local dev uses DATABASE_URL=file:./db/custom.db (or absolute path)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Booking inquiries submitted via the public contact form.
model BookingInquiry {
  id            String   @id @default(cuid())
  organizer     String
  email         String
  phone         String
  eventDate     String
  eventLocation String
  eventType     String
  message       String
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Upcoming / past concert events managed in admin (Gigs tab).
model Gig {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  city        String
  country     String   @default("SK")
  ticketUrl   String?
  ticketPrice String?
  status      String   @default("upcoming")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

/// Gallery / media items managed in admin (Media tab).
model MediaItem {
  id             String   @id @default(cuid())
  title          String
  url            String
  thumbnailUrl   String?
  category       String   @default("concert")
  caption        String?
  altText        String?
  credits        String   @default("Foto: archív D.O.R.A.")
  featured       Boolean  @default(false)
  heroBackground Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([order])
  @@index([heroBackground])
}

/// Admin users for the /admin dashboard.
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Newsletter subscribers (public signup).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Editable site content (CMS key-value store) — also stores settings.* keys.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Per-path SEO metadata.
model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  keywords    String?
  ogImage     String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// =====================================================
// PHASE 2-4: AI BAND MANAGEMENT OS — MODELS
// =====================================================

/// CRM contacts — fans, promoters, venues, festivals, media, sponsors.
model Contact {
  id            String   @id @default(cuid())
  type          String   @default("fan")
  name          String
  email         String?
  phone         String?
  organization  String?
  website       String?
  city          String?
  country       String   @default("SK")
  notes         String?
  aiScore       Float    @default(0)
  tags          String   @default("[]") // JSON-encoded array of strings
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  communications Communication[]
  bookings      Booking[]

  @@index([type])
  @@index([aiScore])
  @@index([status])
}

/// Communication log — emails, calls, meetings, notes.
model Communication {
  id          String   @id @default(cuid())
  contactId   String
  type        String   @default("email")
  direction   String   @default("outbound")
  subject     String?
  body        String
  aiGenerated Boolean  @default(false)
  aiTone      String?
  createdAt   DateTime @default(now())

  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

/// Booking pipeline — tracks negotiation status per gig/contact.
model Booking {
  id            String   @id @default(cuid())
  contactId     String?
  gigId         String?
  status        String   @default("lead")
  aiMatchScore  Float?
  aiAnalysis    String?
  proposedFee   String?
  actualFee     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactId])
}

/// AI-generated and manual tasks with deadlines.
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("medium")
  status      String   @default("todo")
  gigId       String?
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([priority])
}

/// Automation log — tracks AI agent executions.
model AutomationLog {
  id          String   @id @default(cuid())
  agentType   String
  trigger     String
  input       String
  output      String?
  status      String   @default("success")
  createdAt   DateTime @default(now())

  @@index([agentType])
  @@index([createdAt])
}

/// Fan segments for targeted campaigns.
model FanSegment {
  id            String   @id @default(cuid())
  name          String
  description   String?
  criteria      String
  subscriberIds String   @default("[]") // JSON-encoded array of subscriber IDs
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Marketing campaigns (newsletter, social).
model Campaign {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("newsletter")
  subject     String?
  body        String
  status      String   @default("draft")
  segmentId   String?
  scheduledAt DateTime?
  sentAt      DateTime?
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
}
