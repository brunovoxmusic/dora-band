// D.O.R.A. band website — Prisma schema
// DEFAULT: PostgreSQL (Vercel/Neon compatible) — used by `prisma generate` on Vercel build
// For LOCAL DEV with SQLite: use `prisma/schema.sqlite.prisma` via `bun run db:push:dev`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Booking inquiries submitted via the public contact form.
model BookingInquiry {
  id            String   @id @default(cuid())
  organizer     String
  email         String
  phone         String
  eventDate     String
  eventLocation String
  eventType     String
  message       String
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Upcoming / past concert events managed in admin (Gigs tab).
model Gig {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  city        String
  country     String   @default("SK")
  ticketUrl   String?
  ticketPrice String?
  status      String   @default("upcoming")
  notes       String?
  // M2.2: Link to Venue entity (optional — keeps backward compat with string venue)
  venueId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // P0-6: Added FK relations (were orphan String fields)
  bookings    Booking[]
  tasks       Task[]
  // M2.2: Relation to Venue entity
  venueRef    Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
  @@index([venueId])
}

/// Gallery / media items managed in admin (Media tab).
model MediaItem {
  id             String   @id @default(cuid())
  title          String
  url            String
  thumbnailUrl   String?
  category       String   @default("concert")
  caption        String?
  altText        String?
  credits        String   @default("Foto: archív D.O.R.A.")
  featured       Boolean  @default(false)
  heroBackground Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([order])
  @@index([heroBackground])
}

/// Admin users for the /admin dashboard.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   // bcrypt hash (P0: migrated from plaintext `password`)
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// M6.1: Fan 360° — rozšírený Subscriber s profilom a engagement.
model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  active      Boolean  @default(true)
  source      String   @default("website") // website | social | event | referral | import
  // M6.1: Fan 360° polia
  name        String?
  city        String?
  country     String   @default("SK")
  /// Fan journey: visitor → listener → follower → subscriber → attendee → repeat → superfan
  journeyStage String  @default("subscriber")
  /// Segment (LOCAL, CORE_FANS, CASUAL, LIVE_FANS, SUPERFANS, PRESS, INDUSTRY, BOOKERS)
  segment     String?
  /// Number of events attended
  eventsAttended Int   @default(0)
  /// Engagement score (0-100, computed from interactions)
  engagementScore Float @default(0)
  /// Interests (JSON array: genres, event types, etc.)
  interests   String   @default("[]") // JSON-encoded array
  /// First contact date
  firstContactAt DateTime @default(now())
  /// Last interaction date
  lastInteractionAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([journeyStage])
  @@index([segment])
  @@index([city])
}

/// Editable site content (CMS key-value store) — also stores settings.* keys.
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Per-path SEO metadata.
model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  keywords    String?
  ogImage     String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// =====================================================
// PHASE 2-4: AI BAND MANAGEMENT OS — MODELS
// =====================================================

/// CRM contacts — fans, promoters, venues, festivals, media, sponsors.
model Contact {
  id            String   @id @default(cuid())
  type          String   @default("fan") // fan | promoter | venue | festival | media | sponsor
  name          String
  email         String?
  phone         String?
  organization  String?
  organizationId String? // M2.2: FK to Organization entity
  website       String?
  city          String?
  country       String   @default("SK")
  notes         String?
  aiScore       Float    @default(0)
  tags          String   @default("[]") @db.Text // JSON-encoded array of strings
  status        String   @default("active") // active | cold | blacklist
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  communications Communication[]
  bookings      Booking[]
  // M2.2: Relation to Organization entity
  organizationRef Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([aiScore])
  @@index([status])
  @@index([organizationId])
}

/// M2.2: Venue — samostatná entita pre kluby, festivaly, miesta.
model Venue {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("club") // club | festival | cultural_center | outdoor | private
  city        String?
  country     String   @default("SK")
  address     String?
  /// Kapacita (číslo alebo text ako "500-1000")
  capacity    String?
  /// Web stránka venue
  website     String?
  /// Technické vybavenie (PA, monitory, pódiom)
  techInfo    String?  @db.Text
  /// Kontakt na venue
  contactPerson String?
  contactEmail  String?
  contactPhone  String?
  /// Hodnotenie skúsenosti (1-5)
  rating      Int?
  /// Poznámky z minulých vystúpení
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gigs        Gig[]

  @@index([city])
  @@index([type])
}

/// M2.2: Organization — promotéri, festivaly, agentúry ako entity.
model Organization {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("promoter") // promoter | festival | agency | media | sponsor
  email       String?
  phone       String?
  website     String?
  city        String?
  country     String   @default("SK")
  /// IČO (pre fakturáciu)
  vatId       String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts    Contact[]

  @@index([type])
  @@index([city])
}

/// Communication log — emails, calls, meetings, notes.
model Communication {
  id          String   @id @default(cuid())
  contactId   String
  type        String   @default("email") // email | phone | meeting | note
  direction   String   @default("outbound") // inbound | outbound
  subject     String?
  body        String
  aiGenerated Boolean  @default(false)
  aiTone      String?
  createdAt   DateTime @default(now())

  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

/// Booking pipeline — tracks negotiation status per gig/contact.
model Booking {
  id            String   @id @default(cuid())
  contactId     String?
  gigId         String?
  status        String   @default("lead") // lead | contacted | negotiated | confirmed | cancelled
  aiMatchScore  Float?
  aiAnalysis    String?  @db.Text
  proposedFee   String?
  actualFee     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact       Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  gig           Gig?     @relation(fields: [gigId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactId])
  @@index([gigId])
}

/// AI-generated and manual tasks with deadlines.
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  priority    String   @default("medium") // low | medium | high | urgent
  status      String   @default("todo") // todo | in-progress | done | cancelled
  gigId       String?
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gig         Gig?     @relation(fields: [gigId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([priority])
  @@index([gigId])
}

/// Automation log — tracks AI agent executions.
model AutomationLog {
  id          String   @id @default(cuid())
  agentType   String   // content | booking | email | task | social | analytics | orchestrator
  trigger     String   // gig_created | inquiry_received | manual | scheduled
  input       String   @db.Text
  output      String?  @db.Text
  status      String   @default("success") // success | error
  createdAt   DateTime @default(now())

  @@index([agentType])
  @@index([createdAt])
}

/// Fan segments for targeted campaigns.
model FanSegment {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  criteria      String   @db.Text // JSON with filter criteria
  subscriberIds String   @default("[]") @db.Text // JSON-encoded array of subscriber IDs
  aiGenerated   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns     Campaign[]
}

/// Marketing campaigns (newsletter, social).
model Campaign {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("newsletter") // newsletter | social | email
  subject     String?
  body        String   @db.Text
  status      String   @default("draft") // draft | scheduled | sent
  segmentId   String?
  scheduledAt DateTime?
  sentAt      DateTime?
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  segment     FanSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([segmentId])
}

/// M4.1: Knowledge Base — structured facts for AI agents.
/// Every important fact has source, verification status, and confidence.
model KnowledgeItem {
  id          String   @id @default(cuid())
  category    String   // band_identity | history | members | songs | releases | events | venues | contacts | booking_rules | technical_rider | hospitality | pricing | brand_voice | approved_bios | approved_claims | press_quotes | media | faqs
  key         String   // unique key within category (e.g. "founded_year")
  value       String   @db.Text // the actual fact/value
  source      String   @default("unverified") // band_archive | pr_document | official_website | ai_inferred | unverified
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?  // admin email
  confidence  Float    @default(0) // 0-1, AI confidence if inferred
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, key])
  @@index([category])
  @@index([verified])
}

/// M5.1: Song Database — skladby s metadatami, stavom a workflow.
/// Prepojené na Setlist, Gigs a Discography.
model Song {
  id          String   @id @default(cuid())
  title       String
  /// Alternative title or working title
  altTitle    String?
  /// BPM (beats per minute)
  bpm         Int?
  /// Musical key (e.g. "Am", "C", "F#m")
  musicalKey  String?
  /// Guitar tuning (e.g. "Standard", "Drop D")
  tuning      String?
  /// Primary genre
  genre       String   @default("Funky-Punk")
  /// Song status: idea → demo → arrangement → rehearsal → recording → mix → master → released
  status      String   @default("idea")
  /// Duration in MM:SS format
  duration    String?
  /// Lyrics (full text)
  lyrics      String?  @db.Text
  /// Notes about arrangement, performance, etc.
  notes       String?  @db.Text
  /// Release year (if released)
  releaseYear String?
  /// Release title (album/demo name)
  releaseName String?
  /// YouTube video ID (if published)
  videoId     String?
  /// Is this song in the current setlist?
  inSetlist   Boolean  @default(false)
  /// Is this a cover?
  isCover     Boolean  @default(false)
  /// Original artist (if cover)
  originalArtist String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([genre])
  @@index([inSetlist])
}

/// M5.2: Rehearsal Mode — skúšky kapely s setlistom a poznámkami.
model Rehearsal {
  id          String   @id @default(cuid())
  date        DateTime
  /// Zúčastnení členovia (JSON array of member names)
  attendees   String   @default("[]") // JSON-encoded array
  /// Setlist skúšaných skladieb (JSON array of song IDs)
  songIds     String   @default("[]") // JSON-encoded array
  /// Nový materiál (čo sa učili)
  newMaterial String?  @db.Text
  /// Poznámky z skúšky
  notes       String?  @db.Text
  /// Ďalšie úlohy (čo treba doučiť)
  nextActions String?  @db.Text
  /// Nahrané demo/zápisy z skúšky
  recordings  String?  @db.Text // JSON array of URLs
  /// Trvanie skúšky v minútach
  durationMin Int?
  status      String   @default("planned") // planned | done | cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

/// M5.4: Setlist — prepojenie skladieb s koncertmi.
/// Každý setlist je konkrétna zostava pre konkrétny koncert.
model Setlist {
  id          String   @id @default(cuid())
  gigId       String?
  name        String   @default("Setlist")
  /// JSON array of { songId, order, note } objects
  items       String   @default("[]") @db.Text
  /// Celkové trvanie odhadované (MM:SS)
  totalDuration String?
  /// Počet skladieb
  trackCount  Int      @default(0)
  /// Status: draft → confirmed → performed
  status      String   @default("draft")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([gigId])
  @@index([status])
}

/// M3.1: Structured Content Entity — prechádza z key/value na entitný model.
/// Workflow: idea → draft → ai_generated → ai_check → fact_check →
/// human_review → approved → scheduled → published → analyzed
model ContentItem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  type        String   @default("blog") // blog | news | event | page | press_release
  status      String   @default("draft") // idea → draft → ... → published → analyzed
  language    String   @default("sk")
  author      String?
  body        String   @db.Text
  excerpt     String?  @db.Text
  /// SEO title (override)
  seoTitle    String?
  /// SEO description (override)
  seoDescription String?
  /// Keywords (comma-separated)
  keywords    String?
  /// Media IDs linked to this content (JSON array)
  mediaIds    String   @default("[]") @db.Text
  /// Tags (JSON array)
  tags        String   @default("[]") @db.Text
  /// AI generated?
  aiGenerated Boolean  @default(false)
  /// AI quality score (0-100)
  aiQualityScore Float?
  /// Scheduled publish date
  publishAt   DateTime?
  /// Actually published date
  publishedAt DateTime?
  /// Version number (for revision tracking)
  version     Int      @default(1)
  /// Approval: who approved
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([language])
  @@index([publishedAt])
}

/// M7.3: Finance OS — príjmy a náklady per koncert.
model GigFinance {
  id            String   @id @default(cuid())
  gigId         String   @unique
  /// Honorár (fee)
  fee           Float    @default(0)
  /// Cestovné
  travelCost    Float    @default(0)
  /// Ubytovanie
  accommodation Float    @default(0)
  /// Technika / equipment
  equipmentCost Float    @default(0)
  /// Propagácia
  promotionCost Float    @default(0)
  /// Ostatné náklady
  otherCost     Float    @default(0)
  /// Poznámky
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([gigId])
}

/// M4.5: AI Cost Tracking — logovanie AI volaní (tokeny, latencia, cena).
/// Používa sa na sledovanie nákladov a výkonu AI operácií naprieč systémom.
model AiUsageLog {
  id               String   @id @default(cuid())
  /// Ktorý provider (groq, openai, none)
  provider         String
  /// Meno modelu (llama-3.3-70b-versatile, gpt-4o-mini, ...)
  model            String
  /// Kategória tasku (writing, analysis, fast, copilot, market-report, seo, content)
  task             String
  /// Počet tokenov v prompte
  promptTokens     Int      @default(0)
  /// Počet tokenov v odpovedi
  completionTokens Int      @default(0)
  /// Spolu tokenov
  totalTokens      Int      @default(0)
  /// Latencia v ms
  latencyMs        Int      @default(0)
  /// Odhadovaná cena v USD
  costUsd          Float    @default(0)
  /// Úspech alebo chyba
  success          Boolean  @default(true)
  /// Chybové hlásenie ak fail
  errorMessage     String?  @db.Text
  /// Voliteľné ID admina, ktorý spustil operáciu
  userId           String?
  /// Skrátený preview promptu (prvých 200 znakov)
  promptPreview    String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([provider])
  @@index([model])
  @@index([task])
  @@index([createdAt])
  @@index([success])
}

/// M7.4: Merchandise Management — produkty a objednávky.
model MerchProduct {
  id          String   @id @default(cuid())
  /// Názov produktu (napr. "Tričko D.O.R.A. Logo")
  name        String
  /// Slug pre URL
  slug        String   @unique
  /// Popis
  description String?  @db.Text
  /// Kategória: t-shirt, vinyl, cd, poster, sticker, other
  category    String   @default("other")
  /// Cena v EUR
  price       Float
  /// Nákupná cena (pre margin výpočet)
  costPrice   Float    @default(0)
  /// Skladom (ks)
  stock       Int      @default(0)
  /// Minimálna rezerva pre low-stock alert
  minStock    Int      @default(5)
  /// Veľkosti (JSON array: ["S", "M", "L", "XL"])
  sizes       String   @default("[]") @db.Text
  /// Farby (JSON array)
  colors      String   @default("[]") @db.Text
  /// URL obrázku
  imageUrl    String?
  /// Je produkt aktívny / viditeľný?
  active      Boolean  @default(true)
  /// Best-seller badge (vypočítané z predaja)
  bestSeller  Boolean  @default(false)
  /// Dátum vydania / pridania
  releasedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      MerchOrder[]

  @@index([category])
  @@index([active])
  @@index([bestSeller])
}

/// M7.4: Merch objednávky (event sales alebo online objednávky).
model MerchOrder {
  id          String   @id @default(cuid())
  /// Typ: event (predané na koncerte), online, wholesale
  type        String   @default("event")
  /// Reference na gig (ak event predaj)
  gigId       String?
  /// Referencia na produkt
  productId   String
  /// Množstvo
  quantity    Int
  /// Cena za kus (snapshot v čase predaja)
  unitPrice   Float
  /// Veľkosť (ak relevantné)
  size        String?
  /// Farba (ak relevantné)
  color       String?
  /// Kupujúci (ak online — meno/email)
  buyerName   String?
  buyerEmail  String?
  /// Stav: pending, confirmed, shipped, delivered, cancelled, refunded
  status      String   @default("confirmed")
  /// Spôsob platby: cash, card, online, transfer
  paymentMethod String? @default("cash")
  /// Poznámky
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([gigId])
  @@index([productId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
