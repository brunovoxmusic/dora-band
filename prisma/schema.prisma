// D.O.R.A. band website — Prisma schema
// SQLite datasource. Adapted from the Firebase-based spec to use Prisma + SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Booking inquiries submitted via the public contact form (Section G).
model BookingInquiry {
  id          String   @id @default(cuid())
  organizer   String
  email       String
  phone       String
  eventDate   String
  eventLocation String
  eventType   String
  message     String
  status      String   @default("new") // new | reviewed | confirmed | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Upcoming / past concert events managed in admin (Gigs tab).
model Gig {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  city        String
  country     String   @default("SK")
  ticketUrl   String?
  ticketPrice String?
  status      String   @default("upcoming") // upcoming | soldout | cancelled | past
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

/// Gallery / media items managed in admin (Media tab).
model MediaItem {
  id          String   @id @default(cuid())
  title       String
  url         String
  thumbnailUrl String?
  category    String   @default("concert") // concert | portrait | backstage | promo
  caption     String?
  credits     String   @default("Foto: archív D.O.R.A.")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

/// Admin users for the /admin dashboard.
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
