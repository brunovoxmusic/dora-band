// D.O.R.A. band website — Prisma schema (PostgreSQL for Vercel/Neon)
// Use this on Vercel: DATABASE_URL must be postgresql://...

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Booking inquiries submitted via the public contact form.
model BookingInquiry {
  id            String   @id @default(cuid())
  organizer     String
  email         String
  phone         String
  eventDate     String
  eventLocation String
  eventType     String
  message       String
  status        String   @default("new")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Upcoming / past concert events managed in admin (Gigs tab).
model Gig {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  venue       String
  city        String
  country     String   @default("SK")
  ticketUrl   String?
  ticketPrice String?
  status      String   @default("upcoming")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

/// Gallery / media items managed in admin (Media tab).
model MediaItem {
  id             String   @id @default(cuid())
  title          String
  url            String
  thumbnailUrl   String?
  category       String   @default("concert")
  caption        String?
  altText        String?
  credits        String   @default("Foto: archív D.O.R.A.")
  featured       Boolean  @default(false)
  heroBackground Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([order])
  @@index([heroBackground])
}

/// Admin users for the /admin dashboard.
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Newsletter subscribers (public signup).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String   @default("website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Editable site content (CMS key-value store).
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Per-path SEO metadata.
model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  keywords    String?
  ogImage     String?
  noindex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
